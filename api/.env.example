# AutoBK API 

APP_URL=http://autobk.example.com

# Server
PORT=3000
API_INTERNAL_BASE=http://localhost:3000
API_BROWSER_BASE=http://localhost:3000


# Database (MySQL/MariaDB)
# Format: mysql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=mysql://<db_user>:<db_pass>@<db_host>:3306/AutoBk

# REDIS 
REDIS_ENABLE=false
REDIS_URL=redis://localhost:6379
CACHE_TTL_DEVICES_SUMMARY=300

# Auth
JWT_SECRET=please-change-me-to-a-long-random-string-of-32+chars
JWT_TTL_SECONDS=3600

# Defaults
ADMIN_EMAIL=email@email.com
ADMIN_NAME=admin
ADMIN_PASSWORD=pleaseChangeMe

# Files
BACKUP_FILES_DIR=/opt/autobk/backups

# Logging
LOG_LEVEL=info

# Docs
ENABLE_SWAGGER=false

# Agent
# Directory where the autobk.ini file (and its usr_autobk_*.py scripts) is located
AGENT_DIR=/opt/autobk-agent/
# Absolute path to the agent's venv python3, used to run EAS scripts (e.g. the OneNet
# version scrape) on demand from the UI
AGENT_PYTHON=/opt/autobk-agent/venv/bin/python3
# How long to let an EAS script run before the API gives up on it
EAS_RUN_TIMEOUT_MS=600000
# NOTE: the agent's own autobk.ini must have a [EAS] Directory= set to an absolute path --
# that's where EAS scripts write their CSV reports, and where this API looks for them.

# Webhook (daily reports/notifications)
WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=5000

# Email (SMTP)
SMTP_ENABLE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASS=password
SMTP_SECURE=false
MAIL_FROM=
MAIL_NAME=AutoBk

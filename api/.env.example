# AutoBK API 

APP_URL=http://autobk.example.com

# Server
PORT=3000
API_INTERNAL_BASE=http://localhost:3000
API_BROWSER_BASE=http://localhost:3000


# Database (MySQL/MariaDB)
# Format: mysql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=mysql://<db_user>:<db_pass>@<db_host>:3306/AutoBk

# REDIS 
REDIS_ENABLE=false
REDIS_URL=redis://localhost:6379
CACHE_TTL_DEVICES_SUMMARY=300

# Auth
JWT_SECRET=please-change-me-to-a-long-random-string-of-32+chars
JWT_TTL_SECONDS=3600

# Defaults
ADMIN_EMAIL=email@email.com
ADMIN_NAME=admin
ADMIN_PASSWORD=pleaseChangeMe

# Files
BACKUP_FILES_DIR=/opt/autobk/backups

# Logging
LOG_LEVEL=info

# Docs
ENABLE_SWAGGER=false

# Agent
# Directory where the autobk.ini file (and its usr_autobk_*.py scripts) is located
AGENT_DIR=/opt/autobk-agent/
# Absolute path to the agent's venv python3, used to run EAS scripts (e.g. the OneNet
# version scrape) on demand from the UI
AGENT_PYTHON=/opt/autobk-agent/venv/bin/python3
# How long to let an EAS script run before the API gives up on it
EAS_RUN_TIMEOUT_MS=600000
# NOTE: the agent's own autobk.ini must have a [EAS] Directory= set to an absolute path --
# that's where EAS scripts write their CSV reports, and where this API looks for them.

# Webhook (daily reports/notifications)
WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=5000

# Self-update check (api/src/modules/updates) -- which repo to check is NOT configured
# here, it's the GITHUB_REPO constant in src/config/constants.ts, since it never varies
# by deployment. GITHUB_TOKEN is optional: the repo is public, so the check works with no
# token; set one only to raise the GitHub API rate limit (60/hr -> 5000/hr).
GITHUB_TOKEN=
CACHE_TTL_GITHUB_RELEASE=3600
# Where releases/ (and its sibling shared/, current, var/updates/staging/ dirs) live --
# see README.md's "Self-Update" section. Only relevant once you adopt the symlink layout;
# until then the self-update "check" still works, only "apply"/"rollback" need this.
RELEASES_DIR=/opt/autobk-controller/releases
# systemd service name for PHP-FPM, restarted after every apply/rollback swap so PHP
# pages don't keep serving stale opcache-d bytecode from the old release. "php-fpm" is
# correct on RHEL/AlmaLinux; Debian/Ubuntu name it per-version, e.g. php8.3-fpm.
PHP_FPM_SERVICE=php-fpm

# Email (SMTP)
SMTP_ENABLE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=username
SMTP_PASS=password
SMTP_SECURE=false
MAIL_FROM=
MAIL_NAME=AutoBk
